rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "I8vDVys6KyclXQX2v5UaH5JyZR22";
    }

    function hasGuestClaim(eventId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/guestClaims/$(request.auth.uid))
        && get(/databases/$(database)/documents/guestClaims/$(request.auth.uid)).data.eventId == eventId
        && get(/databases/$(database)/documents/guestClaims/$(request.auth.uid)).data.accessToken is string
        && exists(/databases/$(database)/documents/guestGrants/$(eventId))
        && get(/databases/$(database)/documents/guestGrants/$(eventId)).data.accessToken
          == get(/databases/$(database)/documents/guestClaims/$(request.auth.uid)).data.accessToken;
    }

    match /events/{eventId} {
      // 参加者は共有リンクで、その1件だけ閲覧可能。
      allow get: if true;

      // イベント一覧の取得は主催者だけ。ゲスト管理者は不可。
      allow list: if isAdmin();

      // イベント作成は主催者だけ。
      allow create: if isAdmin()
        && request.resource.data.ownerUid == request.auth.uid;

      // 主催者は全編集可。
      // ゲスト管理者はイベント名・候補日時だけ編集可。
      // 参加者は responses の1回答だけ変更可。
      allow update: if isAdmin()
        || (
          hasGuestClaim(eventId)
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['name', 'dates', 'updatedAt'])
        )
        || (
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['responses'])
          && request.resource.data.responses
            .diff(resource.data.responses)
            .affectedKeys()
            .size() == 1
        );

      // 削除は主催者、または専用管理URLを認証済みのゲストだけ。
      allow delete: if isAdmin() || hasGuestClaim(eventId);
    }

    match /guestGrants/{eventId} {
      // 秘密のアクセストークンを含むため、主催者だけが読める。
      allow get, list: if isAdmin();

      // 発行・再発行・削除も主催者だけ。
      allow create, update, delete: if isAdmin();
    }

    match /guestClaims/{uid} {
      // 自分の匿名認証にだけ紐づく内部的な権限証明。
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();

      // URL中の eventId + accessToken が主催者発行の guestGrant と一致した場合だけ
      // 匿名ユーザーが自分自身の claim を作成・更新できる。
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['eventId', 'accessToken', 'claimedAt'])
        && request.resource.data.eventId is string
        && request.resource.data.accessToken is string
        && exists(/databases/$(database)/documents/guestGrants/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/guestGrants/$(request.resource.data.eventId)).data.accessToken
          == request.resource.data.accessToken;

      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
  }
}
